--*** Reserved design-time functions ***
function GetColor(props)
  return BrandColor
end

function GetPrettyName(props)
  return "Furman "
    .. props["Primary Sequencer Model"].Value
    .. " SmartSequencer v"
    .. PluginInfo.BuildVersion
end

function GetProperties()
  return {
    {
      Type = "integer",
      Name = "Number of Secondary Sequencers",
      Min = 0,
      Max = 8,
      Value = 0,
    },
    {
      Type = "enum",
      Choices = { "CN-1800S", "CN-2400S", "CN-3600SE" },
      Name = "Primary Sequencer Model",
      Value = "CN-1800S",
    },
    {
      Type = "integer",
      Name = "Poll Interval (s)",
      Min = 3,
      Max = 60,
      Value = 10,
    },
    {
      Type = "boolean",
      Name = "Auto-Enable Events",
      Value = true,
    },
    {
      Type = "enum",
      Choices = { "None", "Tx/Rx", "Tx", "Rx", "Function Calls", "All" },
      Name = "Debug Print",
      Value = "None",
    },
  }
end

function RectifyProperties(props)
  if props["plugin_show_debug"] then
    props["Debug Print"].IsHidden = not props["plugin_show_debug"].Value
  end
  return props
end

function GetPins(props)
  return { { Name = "Serial Port", Direction = "input", Domain = "serial" } }
end

