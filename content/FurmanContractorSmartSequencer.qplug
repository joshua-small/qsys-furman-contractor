if Controls then
  --*** Control aliases ***
  Status = Controls.ConnectionStatus
  EventLog = Controls.EventLog

  --*** Configuration and runtime variables ***
  MaxUnits = Properties["Number of Secondary Sequencers"].Value + 1
  DebugMode = Properties["Debug Print"].Value
  AutoEvents = Properties["Auto-Enable Events"].Value
  Pending = nil
  RxBuffer = ""
  DiscoveryInvalid = false
  Pumping = false
  Recovering = false
  Tick = 0
  QueryRejected = false
  RecoveryRequiresReconnect = false
  SystemStatusKnown = false

  --*** Runtime objects and tables ***
  SerialPort = SerialPorts and SerialPorts[1]
  PollTimer = Timer.New()
  CommandTimer = Timer.New()
  RecoveryTimer = Timer.New()
  OpenTimer = Timer.New()
  ReplyGapTimer = Timer.New()
  LivenessTimer = Timer.New()
  ReplyGapActive = false
  ActiveReplyFrame = nil
  LastReplyAt = nil
  Queue = {}
  ResponseLines = {}
  Devices = {}
  Discovery = {}
  FeedbackValid = {}
  FeedbackTypes = {}

  --*** Protocol constants ***
  ResponseTimeout = 5
  DiscoveryTimeout = 30
  SequenceTimeoutMargin = 30
  MaximumBankDelay = 420
  RecoveryDelay = 3
  ResetDelay = 5
  SerialOpenDelay = 1
  InterRequestDelay = 0.2
  CommandBufferSize = 32
  QueueCapacityPerUnit = 16
  ResponseLineLimit = 256
  ResponseByteLimit = 32768
  EventLogLimit = 6000

  KeyFields = {
    VOLTAGE = "Voltage",
    CURRENT = "Current",
    WATTS = "Power",
    VA = "PowerVA",
    PF = "PowerFactor",
    SEQ = "SeqPosition",
    ["UART0 PER"] = "PrimaryPER",
    ["UART1 PER"] = "SecondaryPER",
    ["POT ADJ"] = "DelayAdjust",
    ["DIP MAX DELAY"] = "MaxDelay",
    ["TOTAL DELAY"] = "TotalDelay",
    ["DIP MODE"] = "SwitchingMode",
    ["DIP SEQ"] = "SequencerSetting",
    ["DIP ALARM"] = "AlarmSetting",
    ["DIP EVS"] = "EVSSetting",
    KEY = "KeySwitch",
    REMOTE = "RemoteVoltage",
  }
  LedKeys = {
    PROTECT = "ProtectStatus",
    EVS = "ExtremeVoltage",
    ["SMP RLY"] = "SMPRelay",
    ALARM = "Alarm",
    PUSHBUTTON = "Pushbutton",
    SECLINK = "LinkStatus",
    BANK1 = "Bank1Status",
    BANK2 = "Bank2Status",
    BANK3 = "Bank3Status",
  }

  -- Debug flags follow the Generic Display pattern.
  DebugTx = false
  DebugRx = false
  DebugFunction = false

  --*** Runtime functions ***
  function SetupDebugPrint()
    DebugTx = DebugMode == "Tx" or DebugMode == "Tx/Rx" or DebugMode == "All"
    DebugRx = DebugMode == "Rx" or DebugMode == "Tx/Rx" or DebugMode == "All"
    DebugFunction = DebugMode == "Function Calls" or DebugMode == "All"
  end

  function ReportStatus(value, text)
    if value ~= Status.Value or text ~= Status.String then
      print("Furman: " .. text)
    end
    Status.Value = value
    Status.String = text
  end
  function Log(text)
    local previous = EventLog.String or ""
    EventLog.String = (text .. "\n" .. previous):sub(1, EventLogLimit)
    if DebugMode ~= "None" then
      print(text)
    end
  end
  function SeqControl(name, index)
    return MaxUnits == 1 and Controls[name] or Controls[name][index]
  end
  function SetFeedbackAvailable(name, index, available)
    local control = SeqControl(name, index)
    FeedbackValid[index] = FeedbackValid[index] or {}
    FeedbackValid[index][name] = available
    control.IsDisabled = not available
    if not available then
      if FeedbackTypes[name] == "Text" then
        control.String = ""
      else
        control.Boolean = false
      end
    end
  end

  function UpdateControlAvailability()
    local unavailable = not SerialPort or not SerialPort.IsOpen or Recovering
    for _, field in ipairs(SequencerFields) do
      if field.kind == "Button" then
        for i = 1, MaxUnits do
          SeqControl(field.name, i).IsDisabled = unavailable or not Devices[i - 1]
        end
      else
        for i = 1, MaxUnits do
          local valid = FeedbackValid[i] and FeedbackValid[i][field.name]
          SeqControl(field.name, i).IsDisabled = not valid
        end
      end
    end
    for _, field in ipairs(GlobalFields) do
      if field.kind == "Button" and field.name ~= "ReconnectBtn" then
        local needsDevices = field.name:match("^Global") ~= nil
        Controls[field.name].IsDisabled = unavailable or (needsDevices and next(Devices) == nil)
      end
    end
  end
  function RefreshFault()
    local fault = false
    local unknown = next(Devices) == nil
    for seq, device in pairs(Devices) do
      local i = seq + 1
      if not device.status then
        unknown = true
      else
        if
          not SeqControl("ProtectStatus", i).Boolean
          or SeqControl("ExtremeVoltage", i).Boolean
          or SeqControl("Alarm", i).Boolean
        then
          fault = true
        end
        if not device.last and not SeqControl("LinkStatus", i).Boolean then
          fault = true
        end
      end
    end
    SystemStatusKnown = not unknown
    Controls.SystemFault.Boolean = fault
    Controls.SystemFault.IsDisabled = unknown
  end
  function UpdateDiscoverySummary()
    local count = 0
    for _ in pairs(Devices) do
      count = count + 1
    end
    Controls.DiscoveredCount.String =
      string.format("Configured: %d; responding: %d", MaxUnits, count)
    UpdateControlAvailability()
  end
  function ClearFeedback()
    if DebugFunction then
      print("ClearFeedback() Called")
    end
    Devices = {}
    for i = 1, MaxUnits do
      for _, field in ipairs(SequencerFields) do
        local control = SeqControl(field.name, i)
        if field.kind == "Text" then
          control.String = ""
        elseif field.kind == "Led" then
          control.Boolean = false
        end
        if field.kind ~= "Button" then
          SetFeedbackAvailable(field.name, i, false)
        end
        if field.kind == "Button" then
          control.IsDisabled = true
        end
      end
    end
    RefreshFault()
    UpdateDiscoverySummary()
  end
  function GetResponseTimeout(command)
    if command == "!ENUMERATE" or command == "?ROLLCALL" then
      return DiscoveryTimeout
    end
    if command:match("^!SEQ_O") then
      local seq = tonumber(command:match(" (%d+)$"))
      local seconds = SequenceTimeoutMargin
      for id, device in pairs(Devices) do
        if seq == nil or id == seq then
          seconds = seconds + 3 * (device.delay or MaximumBankDelay)
        end
      end
      return seconds
    end
    return ResponseTimeout
  end
  function ServiceQueue()
    if
      Pending
      or ReplyGapActive
      or RxBuffer ~= ""
      or Pumping
      or Recovering
      or not SerialPort
      or not SerialPort.IsOpen
      or #Queue == 0
    then
      return
    end
    local item = table.remove(Queue, 1)
    Pending = item
    Pending.replyStarted = false
    ResponseLines = {}
    QueryRejected = false
    if item.command == "!ENUMERATE" or item.command == "?ROLLCALL" then
      Discovery = {}
      DiscoveryInvalid = false
    end
    if DebugTx then
      print("TX: " .. item.command)
    end
    local ok, err = pcall(function()
      return SerialPort:Write(item.command .. "\r")
    end)
    if not ok or err then
      Pending = nil
      Queue = {}
      ReportStatus(2, "Serial write failed")
      Log(tostring(err))
      ClearFeedback()
      return
    end
    CommandTimer:Start(GetResponseTimeout(item.command))
  end
  function Enqueue(command)
    if Recovering then
      return
    end
    if not SerialPort or not SerialPort.IsOpen then
      Log("Serial port unavailable")
      return
    end
    if #command >= CommandBufferSize then
      Log("Rejected command exceeds Furman receive buffer")
      return
    end
    if command:sub(1, 1) == "?" then
      if Pending and Pending.command == command then
        return
      end
      for _, item in ipairs(Queue) do
        if item.command == command then
          return
        end
      end
    end
    if #Queue >= MaxUnits * QueueCapacityPerUnit then
      Log("Command queue full")
      return
    end
    Queue[#Queue + 1] = {
      command = command,
      query = command:sub(1, 1) == "?",
      seq = tonumber(command:match(" (%d+)")),
    }
    ServiceQueue()
  end
  function QueryDevice(seq, full)
    if DebugFunction then
      print("QueryDevice() Called")
    end
    if not Devices[seq] then
      return
    end
    for _, command in ipairs({
      "STATUS",
      "SETTINGS",
      "VOLTAGE",
      "CURRENT",
      "POWER",
      "POWER_VA",
      "PF",
    }) do
      Enqueue("?" .. command .. " " .. seq)
    end
    if full then
      Enqueue("?ID " .. seq)
      Enqueue("?BANK_STAT " .. seq)
    end
  end
  function CommitDiscovery()
    if DebugFunction then
      print("CommitDiscovery() Called")
    end
    local last = nil
    local count = 0
    for seq, device in pairs(Discovery) do
      if device.last then
        if last ~= nil then
          DiscoveryInvalid = true
        end
        last = seq
      end
      count = count + 1
    end
    if last == nil or count ~= last + 1 then
      DiscoveryInvalid = true
    end
    if not DiscoveryInvalid then
      for seq = 0, last do
        if not Discovery[seq] then
          DiscoveryInvalid = true
        end
      end
    end
    if DiscoveryInvalid then
      ClearFeedback()
      ReportStatus(1, "Discovery incomplete or exceeds configured count")
      Log("Check configured secondary count and SmartLink chain")
      return false
    end
    local old = Devices
    Devices = Discovery
    for i = 1, MaxUnits do
      local seq = i - 1
      local device = Devices[i - 1]
      for _, field in ipairs(SequencerFields) do
        local control = SeqControl(field.name, i)
        if field.kind == "Button" then
          control.IsDisabled = not device
        end
        if not device or not old[seq] or old[seq].model ~= device.model then
          if field.kind == "Text" then
            control.String = ""
          elseif field.kind == "Led" then
            control.Boolean = false
          end
          if field.kind ~= "Button" then
            SetFeedbackAvailable(field.name, i, false)
          end
        end
      end
      SeqControl("Present", i).Boolean = device ~= nil
      SetFeedbackAvailable("Present", i, true)
      if device then
        if old[seq] and old[seq].model == device.model and not old[seq].needsRefresh then
          device.status = old[seq].status
          device.delay = old[seq].delay
        end
        SeqControl("Model", i).String = device.model
        SetFeedbackAvailable("Model", i, true)
        SeqControl("SeqLabel", i).String = (seq == 0 and "Primary" or "Secondary " .. seq)
          .. " - "
          .. device.model
        SeqControl("SeqPosition", i).String = (seq == 0 and "PRIM" or "SEC")
          .. (device.last and ",LAST" or "")
        SetFeedbackAvailable("SeqLabel", i, true)
        SetFeedbackAvailable("SeqPosition", i, true)
      end
    end
    -- Drop queued traffic to units removed from the chain.
    local keep = {}
    for _, item in ipairs(Queue) do
      if item.seq == nil or Devices[item.seq] then
        keep[#keep + 1] = item
      end
    end
    Queue = keep
    UpdateDiscoverySummary()
    RefreshFault()
    for seq = 0, last do
      if not old[seq] or old[seq].model ~= Devices[seq].model or old[seq].needsRefresh then
        if AutoEvents then
          Enqueue("!EVENTS_ENABLE " .. seq)
        end
        QueryDevice(seq, true)
      end
    end
    Log("Discovered " .. count .. " unit(s)")
    return true
  end
  function ApplyValue(seq, key, value)
    if not Devices[seq] then
      return
    end
    key = key:upper():gsub("%s+$", "")
    value = value:gsub("^%s+", ""):gsub("%s+$", "")
    local field = KeyFields[key] or LedKeys[key]
    if not field then
      Log("Unmapped " .. key .. "=" .. value)
      return false
    end
    local control = SeqControl(field, seq + 1)
    if key == "REMOTE" and not value:match("^%+?%d+%.?%d*%s*[Vv]$") then
      SetFeedbackAvailable("RemoteVoltage", seq + 1, false)
      SetFeedbackAvailable("RemoteInput", seq + 1, false)
      return false
    end
    if LedKeys[key] then
      local v = value:upper()
      local valid = (key == "PROTECT" or key == "SECLINK") and (v == "OK" or v == "NOTOK")
        or (key ~= "PROTECT" and key ~= "SECLINK" and (v == "ON" or v == "OFF"))
      if not valid then
        SetFeedbackAvailable(field, seq + 1, false)
        Devices[seq].status = nil
        return false
      end
      control.Boolean = (key == "PROTECT" or key == "SECLINK") and v == "OK"
        or (key ~= "PROTECT" and key ~= "SECLINK" and v == "ON")
    else
      if value == "" then
        SetFeedbackAvailable(field, seq + 1, false)
        return false
      end
      if key == "VOLTAGE" or key == "CURRENT" or key == "WATTS" or key == "VA" or key == "PF" then
        if not tonumber(value) then
          SetFeedbackAvailable(field, seq + 1, false)
          return false
        end
      end
      if key == "SEQ" then
        control.String = tostring(seq)
          .. (seq == 0 and " (Primary)" or " (Secondary)")
          .. (value:find("LAST", 1, true) and " LAST" or "")
      elseif key == "TOTAL DELAY" or key == "DIP MAX DELAY" then
        control.String = value:gsub(" SECONDS", "s"):gsub(" MINUTES", "min")
      else
        control.String = value
      end
    end
    SetFeedbackAvailable(field, seq + 1, true)
    if key == "REMOTE" then
      SeqControl("RemoteInput", seq + 1).Boolean = (tonumber(value:match("[%d%.]+")) or 0) > 0
      SetFeedbackAvailable("RemoteInput", seq + 1, true)
    elseif key == "TOTAL DELAY" then
      local amount = tonumber(value:match("[%d%.]+"))
      Devices[seq].delay = amount and amount * (value:upper():find("MIN", 1, true) and 60 or 1)
    end
    return true
  end
  function ParseAck(line)
    local seq, rest = line:match("^%$ACK%s+(%d+)%s*,?%s*(.-)%s*$")
    return tonumber(seq), rest
  end
  function DiscoveryLine(line)
    local seq, rest = ParseAck(line)
    if not seq then
      return
    end
    local model, tail = rest:match("^(CN%-%w[%w%-]*)%s*,?%s*(.-)%s*$")
    if not model then
      return
    end
    if seq >= MaxUnits or Discovery[seq] then
      DiscoveryInvalid = true
      return
    end
    Discovery[seq] = { model = model, last = tail == "LAST" }
  end
  function CompleteCommand(success)
    local item = Pending
    if not item then
      return
    end
    CommandTimer:Stop()
    ReplyGapActive = true
    ReplyGapTimer:Start(InterRequestDelay)
    Pending = nil
    ResponseLines = {}
    QueryRejected = false
    if success then
      local found = 0
      for _ in pairs(Devices) do
        found = found + 1
      end
      local mismatch = found ~= MaxUnits
        or (Devices[0] and Devices[0].model ~= Properties["Primary Sequencer Model"].Value)
      ReportStatus(
        mismatch and 1 or 0,
        mismatch and "Responding; check model / secondary count" or "Responding"
      )
      if
        item.command:match("^!SEQ_O")
        or item.command:match("^!ALL_OFF")
        or item.command:match("^!BANK_")
        or item.command:match("^!CLEAR_PER")
      then
        if item.seq then
          Enqueue("?STATUS " .. item.seq)
        else
          for seq in pairs(Devices) do
            Enqueue("?STATUS " .. seq)
          end
        end
      elseif item.command:match("^!RESET") then
        local device = Devices[item.seq]
        if device then
          device.needsRefresh = true
          device.status = nil
          for _, field in ipairs(SequencerFields) do
            local control = SeqControl(field.name, item.seq + 1)
            if field.kind ~= "Button" and field.name ~= "Present" then
              SetFeedbackAvailable(field.name, item.seq + 1, false)
              if field.kind == "Text" then
                control.String = ""
              else
                control.Boolean = false
              end
            end
          end
        end
        Recovering = true
        RecoveryTimer:Start(ResetDelay)
      end
    else
      ReportStatus(1, "Rejected or unexpected reply: " .. item.command)
    end
    RefreshFault()
    UpdateControlAvailability()
  end
  function HandleDeviceEvent(line)
    Log(line)
    if line:find("SEQ_CHANGE", 1, true) then
      Enqueue("!ENUMERATE")
      return
    end
    local seq = tonumber(line:match("(%d+)"))
    if seq and Devices[seq] then
      Enqueue("?STATUS " .. seq)
    else
      for id in pairs(Devices) do
        Enqueue("?STATUS " .. id)
      end
    end
  end
  function CommandReply(line)
    if not Pending then
      return false
    end
    local command = Pending.command
    if command == "!ENUMERATE" then
      DiscoveryLine(line)
      if line:match("LAST%s*$") then
        CompleteCommand(CommitDiscovery())
        return true
      end
      return false
    end
    local verb = command:match("^!([%w_]+)")
    if not verb then
      return false
    end
    local seq, rest = ParseAck(line)
    if Pending.seq == nil then
      if (verb == "SEQ_ON" or verb == "SEQ_OFF") and line == "$" .. verb .. "_DONE" then
        CompleteCommand(true)
        return true
      end
      return false
    end
    if seq ~= Pending.seq then
      return false
    end
    if verb == "SEQ_ON" or verb == "SEQ_OFF" then
      if rest ~= verb .. "_DONE" then
        return false
      end
    elseif verb == "BANK_ON" or verb == "BANK_OFF" then
      local bank = tonumber(command:match(" (%d+)$"))
      if not rest:match("^" .. verb .. "%s+" .. bank .. "%s*=") then
        return false
      end
      -- BANK_OFF=ON is a vendor typo: read authoritative BANK_STAT instead.
      Enqueue("?BANK_STAT " .. seq)
    elseif rest ~= verb then
      return false
    end
    if verb == "EVENTS_ENABLE" or verb == "EVENTS_DISABLE" then
      SeqControl("EventsEnabled", seq + 1).Boolean = verb == "EVENTS_ENABLE"
      SetFeedbackAvailable("EventsEnabled", seq + 1, true)
    end
    CompleteCommand(true)
    return true
  end
  -- Reply ownership and transport liveness are independent of the polling queue.
  function CommunicationGrace()
    return math.max(3 * Properties["Poll Interval (s)"].Value, 3 * ResponseTimeout)
  end
  function NoteReply()
    LastReplyAt = Timer.Now()
  end
  function ReplyKeyAllowed(kind, key)
    if kind == "STATUS" then
      return LedKeys[key] ~= nil
        or key == "SEQ"
        or key == "REMOTE"
        or key == "UART0 PER"
        or key == "UART1 PER"
    end
    if kind == "SETTINGS" then
      return key == "POT ADJ"
        or key == "DIP MAX DELAY"
        or key == "TOTAL DELAY"
        or key == "DIP MODE"
        or key == "DIP SEQ"
        or key == "DIP ALARM"
        or key == "DIP EVS"
        or key == "KEY"
    end
    if kind == "BANK_STAT" then
      return key:match("^BANK[123]$") ~= nil
    end
    local scalar =
      { VOLTAGE = "VOLTAGE", CURRENT = "CURRENT", POWER = "WATTS", POWER_VA = "VA", PF = "PF" }
    return scalar[kind] == key
  end
  function AddReplyLine(frame, text)
    frame.bytes = frame.bytes + #text
    if #frame.lines >= ResponseLineLimit or frame.bytes > ResponseByteLimit then
      frame.overflow = true
      if frame.owner == Pending then
        CompleteCommand(false)
      end
      ActiveReplyFrame = nil
      Log("Reply frame limit exceeded")
      return false
    end
    frame.lines[#frame.lines + 1] = text
    return true
  end
  function ApplyReplyLine(frame, text)
    if frame.seq ~= nil and not Devices[frame.seq] then
      return
    end
    if frame.kind == "HELP" then
      Controls.HelpResponse.String = table.concat(frame.lines, "\n")
      frame.valid = true
      NoteReply()
      return
    end
    if frame.kind == "ID" then
      if #frame.lines == 6 then
        for i, field in ipairs({
          "Brand",
          "Model",
          "SerialNumber",
          "FirmwareRevision",
          "RevisionDate",
        }) do
          SeqControl(field, frame.seq + 1).String = frame.lines[i + 1]
          SetFeedbackAvailable(field, frame.seq + 1, true)
        end
        Devices[frame.seq].model = frame.lines[3]
        SeqControl("SeqLabel", frame.seq + 1).String = (
          frame.seq == 0 and "Primary" or "Secondary " .. frame.seq
        )
          .. " - "
          .. frame.lines[3]
        frame.valid = true
        NoteReply()
      end
      return
    end
    local key, value = text:match("^([%w_%. ]-)%s*=%s*(.-)%s*$")
    if key and ReplyKeyAllowed(frame.kind, key) and ApplyValue(frame.seq, key, value) then
      frame.valid = true
      frame.seen[key] = true
      frame.lastAt = Timer.Now()
      NoteReply()
      if frame.kind == "STATUS" then
        local v = FeedbackValid[frame.seq + 1] or {}
        Devices[frame.seq].status = v.ProtectStatus
          and v.ExtremeVoltage
          and v.Alarm
          and v.LinkStatus
      end
      RefreshFault()
    end
  end
  function StartReplyFrame(text)
    local seq, rest = ParseAck(text)
    local kind
    if Pending and Pending.command == "?ROLLCALL" and seq and rest:match("^CN%-") then
      local frame = Pending.replyFrame
      if not frame then
        frame = {
          kind = "ROLLCALL",
          lines = {},
          bytes = 0,
          seen = {},
          owner = Pending,
          lastAt = Timer.Now(),
        }
        Pending.replyFrame = frame
      end
      ActiveReplyFrame = frame
      AddReplyLine(frame, text)
      NoteReply()
      return true
    end
    if text == "Commands" and Pending and Pending.command == "?HELP" then
      kind = "HELP"
    elseif seq and Devices[seq] then
      if rest == "STATUS" or rest == "SETTINGS" or rest == "BANK_STAT" or rest == "ID" then
        kind = rest
      else
        local key = rest:match("^([%w_ ]-)%s*=")
        kind = ({
          VOLTAGE = "VOLTAGE",
          CURRENT = "CURRENT",
          WATTS = "POWER",
          VA = "POWER_VA",
          PF = "PF",
        })[key]
      end
    end
    if not kind then
      return false
    end
    local owner = Pending
        and Pending.query
        and (Pending.command == "?HELP" and kind == "HELP" or Pending.seq == seq and Pending.command == "?" .. kind .. " " .. seq)
        and Pending
      or nil
    local frame = {
      kind = kind,
      seq = seq,
      owner = owner,
      lines = {},
      bytes = 0,
      seen = {},
      lastAt = Timer.Now(),
    }
    ActiveReplyFrame = frame
    if owner then
      owner.replyFrame = frame
      owner.replyStarted = true
      ResponseLines = frame.lines
    end
    if AddReplyLine(frame, text) then
      if kind ~= "ID" then
        ApplyReplyLine(frame, rest or text)
      end
    end
    NoteReply()
    return true
  end
  function FinishQueryFrame()
    -- EOT may delimit only a segment. Preserve the frame and its address context.
    if ActiveReplyFrame then
      ActiveReplyFrame.eot = true
    end
    if Pending and Pending.query and QueryRejected then
      Pending.errorEot = true
    end
  end
  function SettleQueryReply()
    if not Pending or not Pending.query then
      return
    end
    if QueryRejected then
      if Pending.errorEot then
        CompleteCommand(false)
      end
      return
    end
    local frame = Pending.replyFrame
    if not frame or frame.overflow then
      return
    end
    if frame.kind == "ROLLCALL" then
      -- Topology replacement still requires a complete, validated LAST response.
      if not frame.eot then
        return
      end
      local last = false
      for _, line in ipairs(frame.lines) do
        if line:match(",%s*LAST%s*$") then
          last = true
        end
      end
      if not last then
        return
      end
      for _, line in ipairs(frame.lines) do
        DiscoveryLine(line)
      end
      CompleteCommand(CommitDiscovery())
    elseif frame.valid then
      CompleteCommand(true)
    elseif frame.eot then
      CompleteCommand(false)
    end
  end
  function ProcessToken(text, eot)
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    if DebugRx then
      print("RX: " .. text)
    end
    if text:sub(1, 1) == "*" then
      local seq = tonumber(text:match("(%d+)"))
      if seq and Devices[seq] then
        NoteReply()
      end
      HandleDeviceEvent(text)
    elseif
      text:match("^%$INVALID[%s_]COMMAND")
      or text:match("^%$INVALID[%s_]PARAMETER")
      or text:match("^%$COMMAND[%s_]CONFLICT")
    then
      NoteReply()
      Log(text)
      if Pending and Pending.query then
        QueryRejected = true
      else
        CompleteCommand(false)
      end
    elseif text ~= "" then
      local helpBody = ActiveReplyFrame
        and ActiveReplyFrame.kind == "HELP"
        and ActiveReplyFrame.owner == Pending
      if Pending and text == Pending.command then
        if eot then
          FinishQueryFrame()
        end
        return
      elseif text:match("^[!?]") and not helpBody then
        -- Ignore late command echoes too, without filtering HELP descriptions.
        if eot then
          FinishQueryFrame()
        end
        return
      elseif not (Pending and Pending.query) and CommandReply(text) then
        NoteReply()
      elseif not StartReplyFrame(text) then
        if text:match("^%$ACK") then
          ActiveReplyFrame = nil
        elseif
          ActiveReplyFrame and Timer.Now() - ActiveReplyFrame.lastAt <= CommunicationGrace()
        then
          local frame = ActiveReplyFrame
          if AddReplyLine(frame, text) then
            ApplyReplyLine(frame, text)
          end
        end
      end
    end
    if eot then
      FinishQueryFrame()
    end
  end
  function OnData()
    if DebugFunction then
      print("OnData() Called")
    end
    local data = SerialPort:Read(SerialPort.BufferLength)
    if not data then
      return
    end
    if Recovering and not RecoveryRequiresReconnect then
      RecoveryTimer:Start(RecoveryDelay)
    end
    if DebugRx then
      local hex = data:sub(1, 256):gsub(".", function(byte)
        return string.format("%02X ", byte:byte())
      end)
      print("RX bytes: " .. hex .. (#data > 256 and "..." or ""))
    end
    ReplyGapActive = true
    ReplyGapTimer:Start(InterRequestDelay)
    RxBuffer = RxBuffer .. data
    if #RxBuffer > ResponseByteLimit then
      Log("Receive buffer overflow")
      RxBuffer = ""
      Queue = {}
      Pending = nil
      CommandTimer:Stop()
      QueryRejected = false
      Recovering = true
      ClearFeedback()
      RecoveryTimer:Start(RecoveryDelay)
      ReportStatus(2, "Receive buffer overflow")
      return
    end
    Pumping = true
    while true do
      local at = RxBuffer:find("[\r\n\004]")
      if not at then
        break
      end
      local token = RxBuffer:sub(1, at - 1)
      local ending = RxBuffer:sub(at, at)
      RxBuffer = RxBuffer:sub(at + 1)
      ProcessToken(token, ending == string.char(4))
    end
    Pumping = false
    UpdateControlAvailability()
    ServiceQueue()
  end
  function OnDisconnected(port, message)
    LivenessTimer:Stop()
    ActiveReplyFrame = nil
    LastReplyAt = nil
    ReplyGapTimer:Stop()
    ReplyGapActive = false
    if DebugFunction then
      print("OnDisconnected() Called")
    end
    PollTimer:Stop()
    CommandTimer:Stop()
    RecoveryTimer:Stop()
    Queue = {}
    Pending = nil
    RxBuffer = ""
    ResponseLines = {}
    Recovering = false
    QueryRejected = false
    ReportStatus(4, "Disconnected")
    Log(message or "Serial closed")
    ClearFeedback()
  end
  function OnConnected()
    LivenessTimer:Start(ResponseTimeout)
    ActiveReplyFrame = nil
    LastReplyAt = nil
    ReplyGapTimer:Stop()
    ReplyGapActive = false
    if DebugFunction then
      print("OnConnected() Called")
    end
    CommandTimer:Stop()
    RecoveryTimer:Stop()
    Queue = {}
    Pending = nil
    RxBuffer = ""
    ResponseLines = {}
    Recovering = false
    QueryRejected = false
    RecoveryRequiresReconnect = false
    ClearFeedback()
    ReportStatus(5, "Discovering SmartLink chain")
    Enqueue("!ENUMERATE")
    PollTimer:Start(Properties["Poll Interval (s)"].Value)
  end
  function OpenSerialPort()
    if DebugFunction then
      print("OpenSerialPort() Called")
    end
    if not SerialPort then
      ReportStatus(4, "Serial pin not connected")
      ClearFeedback()
      return
    end
    if SerialPort.IsOpen then
      SerialPort:Close()
    end
    local ok, err = pcall(function()
      return SerialPort:Open(19200, 8, "N", 1)
    end)
    if not ok or err then
      ReportStatus(2, "Serial open failed")
      Log(tostring(err))
    end
  end
  function SendDeviceCommand(seq, name)
    if DebugFunction then
      print("SendDeviceCommand() Called")
    end
    if not Devices[seq] then
      return
    end
    local verbs = {
      SeqOnBtn = "SEQ_ON",
      SeqOffBtn = "SEQ_OFF",
      AllOffBtn = "ALL_OFF",
      ResetBtn = "RESET",
      ClearPERBtn = "CLEAR_PER",
      EventsOnBtn = "EVENTS_ENABLE",
      EventsOffBtn = "EVENTS_DISABLE",
    }
    if verbs[name] then
      Enqueue("!" .. verbs[name] .. " " .. seq)
      return
    end
    local bank, action = name:match("^Bank(%d)(%a+)Btn$")
    if bank then
      Enqueue("!BANK_" .. action:upper() .. " " .. seq .. " " .. bank)
    end
  end

  --*** Event handlers ***
  LivenessTimer.EventHandler = function()
    -- Long-running control commands may legitimately be silent until DONE.
    if Pending and not Pending.query then
      return
    end
    if not LastReplyAt or Timer.Now() - LastReplyAt <= CommunicationGrace() then
      return
    end
    LastReplyAt = nil
    ActiveReplyFrame = nil
    ReplyGapTimer:Stop()
    ReplyGapActive = false
    CommandTimer:Stop()
    Pending = nil
    Queue = {}
    ResponseLines = {}
    QueryRejected = false
    RxBuffer = ""
    ClearFeedback()
    ReportStatus(4, "No recent valid replies")
    if not RecoveryRequiresReconnect then
      Recovering = true
      RecoveryTimer:Start(RecoveryDelay)
    end
    UpdateControlAvailability()
  end

  CommandTimer.EventHandler = function()
    CommandTimer:Stop()
    local command = Pending and Pending.command or "unknown"
    Log("Timed out: " .. command)
    local responding = LastReplyAt and Timer.Now() - LastReplyAt <= CommunicationGrace()
    if Pending and Pending.query and responding then
      Pending = nil
      ResponseLines = {}
      QueryRejected = false
      ReportStatus(1, "Responding; poll delayed: " .. command)
      ReplyGapActive = true
      ReplyGapTimer:Start(InterRequestDelay)
      UpdateControlAvailability()
      return
    end
    ReplyGapTimer:Stop()
    ReplyGapActive = false
    ActiveReplyFrame = nil
    Queue = {}
    Pending = nil
    ResponseLines = {}
    RxBuffer = ""
    QueryRejected = false
    if responding then
      ReportStatus(1, "Responding; command unconfirmed: " .. command)
    else
      ReportStatus(4, "No reply: " .. command)
      ClearFeedback()
    end
    -- A sequence completion can take minutes; never overlap it with a new command.
    if command:match("^!SEQ_O") then
      Recovering = true
      RecoveryRequiresReconnect = true
    else
      Recovering = true
      RecoveryTimer:Start(RecoveryDelay)
    end
    UpdateControlAvailability()
  end
  RecoveryTimer.EventHandler = function()
    RecoveryTimer:Stop()
    ReplyGapTimer:Stop()
    ReplyGapActive = false
    ActiveReplyFrame = nil
    if SerialPort and SerialPort.BufferLength > 0 then
      SerialPort:Read(SerialPort.BufferLength)
    end
    RxBuffer = ""
    Recovering = false
    if not Devices[0] then
      Enqueue("!ENUMERATE")
    else
      Enqueue("?ROLLCALL")
    end
    UpdateControlAvailability()
    ServiceQueue()
  end
  PollTimer.EventHandler = function()
    if not Pending and #Queue == 0 and not Recovering then
      Tick = Tick + 1
      if next(Devices) == nil or Tick % 6 == 0 then
        Enqueue("?ROLLCALL")
      end
      for seq = 0, MaxUnits - 1 do
        if Devices[seq] then
          QueryDevice(seq, false)
        end
      end
    end
    PollTimer:Start(Properties["Poll Interval (s)"].Value)
  end
  for _, field in ipairs(SequencerFields) do
    if field.kind == "Button" then
      for i = 1, MaxUnits do
        local seq = i - 1
        local name = field.name
        SeqControl(name, i).EventHandler = function(ctl)
          if ctl.Value == 1 then
            SendDeviceCommand(seq, name)
          end
        end
      end
    end
  end
  GlobalActions = {
    GlobalSeqOn = function()
      if next(Devices) then
        Enqueue("!SEQ_ON")
      end
    end,
    GlobalSeqOff = function()
      if next(Devices) then
        Enqueue("!SEQ_OFF")
      end
    end,
    EnumerateBtn = function()
      Enqueue("!ENUMERATE")
    end,
    RollCallBtn = function()
      Enqueue("?ROLLCALL")
    end,
    HelpBtn = function()
      Enqueue("?HELP")
    end,
    ReconnectBtn = OpenSerialPort,
  }
  for name, fn in pairs(GlobalActions) do
    local action = fn
    Controls[name].EventHandler = function(ctl)
      if ctl.Value == 1 then
        action()
      end
    end
  end
  for name, verb in pairs({
    GlobalAllOff = "ALL_OFF",
    GlobalEventsOn = "EVENTS_ENABLE",
    GlobalEventsOff = "EVENTS_DISABLE",
    GlobalClearPER = "CLEAR_PER",
    GlobalReset = "RESET",
  }) do
    local command = verb
    Controls[name].EventHandler = function(ctl)
      if ctl.Value == 1 then
        -- Reset secondaries first and the primary last, because it carries serial traffic.
        for seq = MaxUnits - 1, 0, -1 do
          if Devices[seq] then
            Enqueue("!" .. command .. " " .. seq)
          end
        end
      end
    end
  end
  if SerialPort then
    SerialPort.Data = OnData
    SerialPort.Connected = OnConnected
    SerialPort.Closed = OnDisconnected
    SerialPort.Error = OnDisconnected
    SerialPort.Timeout = OnDisconnected
  end

  ReplyGapTimer.EventHandler = function()
    ReplyGapTimer:Stop()
    if SerialPort and SerialPort.BufferLength > 0 then
      OnData()
      return
    end
    if RxBuffer ~= "" and Pending then
      -- An undelimited partial line remains buffered until more data or timeout.
      return
    end
    SettleQueryReply()
    if RxBuffer ~= "" then
      Log("Discarded unterminated idle receive tail after quiet interval")
      RxBuffer = ""
    end
    ReplyGapTimer:Stop()
    ReplyGapActive = false
    ServiceQueue()
  end

  OpenTimer.EventHandler = function()
    OpenTimer:Stop()
    OpenSerialPort()
  end

  --*** Initialization ***
  function Initialization()
    SetupDebugPrint()
    for _, field in ipairs(SequencerFields) do
      FeedbackTypes[field.name] = field.kind
    end
    Controls.BaudRate.String = "19200"
    Controls.StartBits.String = "1"
    Controls.DataBits.String = "8"
    Controls.StopBits.String = "1"
    Controls.Parity.String = "None"
    Controls.FlowControl.String = "None"
    Controls.HelpResponse.String = ""
    EventLog.String = ""
    print("Furman SmartSequencer " .. PluginInfo.Version)
    ClearFeedback()
    ReportStatus(5, "Initializing")
    OpenTimer:Start(SerialOpenDelay)
  end

  Initialization()
end
