function GetPages(props)
  local pages = { { name = "Global" } }
  for seq = 0, props["Number of Secondary Sequencers"].Value do
    table.insert(pages, { name = "Sequencer " .. seq })
  end
  table.insert(pages, { name = "Diagnostics" })
  return pages
end

function GetControlLayout(props)
  local count = props["Number of Secondary Sequencers"].Value + 1
  local page = props["page_index"] and props["page_index"].Value or 1
  local layout = GetHiddenLayout(count)
  local pageLayout
  local graphics

  if page == 1 then
    pageLayout, graphics = GetGlobalLayout()
  elseif page <= count + 1 then
    pageLayout, graphics = GetSequencerLayout(page - 1, count)
  else
    pageLayout, graphics = GetDiagnosticsLayout()
  end

  for name, entry in pairs(pageLayout) do
    entry.PrettyName = layout[name].PrettyName
    layout[name] = entry
  end
  return layout, graphics
end

--*** Design-time layout helpers ***
function LayoutKey(name, index, count)
  return count == 1 and name or name .. " " .. index
end

function GetHiddenLayout(count)
  local layout = {}
  layout.ConnectionStatus = {
    Style = "None",
    Position = { 0, 0 },
    Size = { 1, 1 },
    PrettyName = "System~Connection Status",
  }
  layout.SystemFault = {
    Style = "None",
    Position = { 0, 0 },
    Size = { 1, 1 },
    PrettyName = "System~System Fault",
